{
  "name": "sat-practice",
  "version": "1.0.0",
  "private": true,
  "description": "SAT Practice — cross-platform (web + Android via Capacitor)",
  "scripts": {
    "init": "cap init 'SAT Practice' 'app.satpractice.local' --web-dir=../www",
    "add-android": "cap add android",
    "sync": "cap sync",
    "open-android": "cap open android",
    "build-apk": "cd android && ./gradlew assembleDebug && echo 'APK at android/app/build/outputs/apk/debug/app-debug.apk'"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
